# App
APP_NAME="PortWatch AI"
APP_VERSION="1.0.0"
DEBUG=False

# Data
DATA_DIR="data"
USE_SAMPLE_DATA=False

# Database
DATABASE_URL="duckdb:///data/processed/portwatch.duckdb"

# ML
MODEL_DIR="models"
RANDOM_SEED=42
FORECAST_HORIZON=7

# API
API_HOST="0.0.0.0"
API_PORT=8000
CORS_ORIGINS=["*"]
RATE_LIMIT="100/minute"

# External APIs
GDACS_API_URL="https://www.gdacs.org/gdacsapi/api/Events/geteventlist/SEARCH"
WORLD_BANK_API_URL="https://api.worldbank.org/v2"
